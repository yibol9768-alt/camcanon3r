{
  "schema_version": "0.1",
  "method_name": "canonical_orbit_projection",
  "baseline_commit": "e03cbb34cad2a87ed9f12788b93dba3901ee9cd5",
  "development_branch": "fancy/orbit-projection",
  "frozen_before_any_orbit_projection_ground_truth_result": true,
  "historical_evidence_was_known_when_designed": true,
  "historical_evidence_boundary": {
    "known": [
      "ETH3D and DTU preprocessing-mechanism results",
      "support-preserving letterbox-control results",
      "one-pass canonical repair results",
      "three-fill selector and oracle results"
    ],
    "not_yet_observed": [
      "any projected camera prediction",
      "any ground-truth metric for a projected camera prediction",
      "any result from the nine-member canonical placement orbit"
    ]
  },
  "method_scope": {
    "primary_output": "projected_world_to_camera_extrinsics",
    "primary_claim": "camera_orientation_repair",
    "not_claimed": [
      "recovery of pixels removed by cropping",
      "generic depth repair",
      "generic point-map repair",
      "calibrated posterior uncertainty"
    ],
    "ground_truth_available_to_method": false,
    "original_uncropped_pixels_available_to_method": false,
    "backbone_weights_updated": false
  },
  "orbit": {
    "source_variant": "canonical_asymmetric_crop_075",
    "canvas_scale": 1.25,
    "resample_visible_pixels": false,
    "fill_rgb": [127, 127, 127],
    "same_placement_for_all_views_within_a_run": true,
    "ordered_members": [
      {"label": "center", "placement": [0.5, 0.5], "inverse_pair": "center"},
      {"label": "left", "placement": [0.0, 0.5], "inverse_pair": "right"},
      {"label": "right", "placement": [1.0, 0.5], "inverse_pair": "left"},
      {"label": "top", "placement": [0.5, 0.0], "inverse_pair": "bottom"},
      {"label": "bottom", "placement": [0.5, 1.0], "inverse_pair": "top"},
      {"label": "top_left", "placement": [0.0, 0.0], "inverse_pair": "bottom_right"},
      {"label": "bottom_right", "placement": [1.0, 1.0], "inverse_pair": "top_left"},
      {"label": "top_right", "placement": [1.0, 0.0], "inverse_pair": "bottom_left"},
      {"label": "bottom_left", "placement": [0.0, 1.0], "inverse_pair": "top_right"}
    ],
    "integrity_requirements": [
      "every source RGB byte appears exactly once in every orbit member",
      "every source validity-mask byte appears exactly once in every orbit member",
      "all orbit members have the same canvas size and added fill-pixel count",
      "the only member-varying field is the registered canvas translation"
    ]
  },
  "projection": {
    "rotation_representation": "gauge_invariant_complete_relative_rotation_graph",
    "pair_symmetrization": "inverse-placement-pair chordal mean",
    "robust_loss": "tukey_biweight",
    "tuning_constant": 4.685,
    "robust_scale_floor_degrees": 0.25,
    "minimum_effective_groups": 3,
    "absolute_rotation_recovery": "weighted_SO3_synchronization_with_first_camera_gauge",
    "center_recovery": "root_camera_coordinates_then_per_run_median_baseline_normalization_and_geometric_median",
    "tie_break": "ordered_member_label",
    "ground_truth_used": false,
    "native_confidence_used": false
  },
  "baselines": [
    "one_pass_neutral_gray_analytic_repair",
    "orbit_medoid_selection",
    "uniform_chordal_orbit_projection",
    "native_confidence_selection",
    "ground_truth_oracle_selection_upper_bound"
  ],
  "development_stages": {
    "stage_0": "synthetic unit tests and retrospective existing-output feasibility",
    "stage_1": "ETH3D nine-member orbit development and ablation",
    "stage_2": "freeze implementation hash before DTU orbit evaluation",
    "stage_3": "single-pass affine-aware graph correction only if multi-run promotion passes"
  },
  "multi_run_promotion": {
    "primary_metric": "median_pairwise_relative_rotation_degrees",
    "minimum_residual_gap_reduction_vs_one_pass": 0.15,
    "maximum_median_error_increase_degrees": 0.1,
    "must_pass_models": ["vggt", "dust3r"],
    "must_pass_datasets": ["eth3d", "dtu"],
    "must_beat_or_tie_uniform_projection": true,
    "must_beat_or_tie_orbit_medoid": true,
    "scene_cluster_bootstrap_replicates": 10000,
    "confidence_level": 0.95,
    "bootstrap_seed": 1701
  },
  "single_pass_distillation_trigger": {
    "enabled_only_after_multi_run_promotion": true,
    "teacher": "frozen_canonical_orbit_projection",
    "student_input": [
      "one_backbone_camera_prediction",
      "registered_per_view_affine",
      "valid_support_fraction",
      "native_model_confidence"
    ],
    "student_output": ["per_view_se3_correction", "failure_score"],
    "minimum_teacher_gain_retained": 0.8,
    "backbone_forward_runs_at_test_time": 1
  },
  "reporting": {
    "models_and_datasets_never_pooled": true,
    "undefined_values_never_imputed": true,
    "negative_results_retained": true,
    "paper_writing_out_of_scope_until_user_review": true
  }
}
